{
  "crons": [
    {
      "path": "/api/cron/verification",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/recap",
      "schedule": "0 5 * * *"
    }
  ],
  "regions": [
    "cdg1"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Alt-Svc",
          "value": "clear"
        }
      ]
    }
  ]
}